<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="RtcAuthCondition">

	<!--
		실제 차량 조회 매퍼에서 include할 권한 조건의 골격입니다.
		회사·사업부·부서·담당자 컬럼은 실제 차량/재고 테이블 정의 후 연결합니다.
		SQL 식별자 치환값은 사용자 입력이 아니라 서버의 허용 목록에서만 선택해야 합니다.
	-->
	<sql id="dataScopeCondition">
		<choose>
			<when test="dataScope == 'ALL'">
				<!-- 제한 없음 -->
			</when>
			<when test="dataScope == 'COMPANY'">
				AND ${companyColumn} = #{companyCd}
			</when>
			<when test="dataScope == 'BIZ_DIVISION'">
				AND ${bizDivisionColumn} = #{bizTopDptCd}
			</when>
			<when test="dataScope == 'DEPARTMENT'">
				AND ${departmentColumn} = #{dptCd}
			</when>
			<when test="dataScope == 'SELF'">
				AND ${ownerColumn} = #{userId}
			</when>
			<otherwise>
				AND 1 = 0
			</otherwise>
		</choose>
	</sql>
</mapper>
